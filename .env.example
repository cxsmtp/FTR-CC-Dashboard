# Copy to .env (never commit it). Every setting is optional.
PORT=8443
HOST=0.0.0.0
# Where everything is kept: back this folder up.
DATA_DIR=./data
# The first Admin, made on the first start (their one-time password is written to DATA_DIR/initial-admin-password.txt).
ADMIN_EMAIL=you@yourcompany.com
ADMIN_NAME=Your Name
# The address people use; with https it also makes cookies Secure. Requests from any other origin are refused.
PUBLIC_URL=https://credits.internal.yourcompany.com
# Serve https directly (or put the server behind a reverse proxy that does, and set TRUST_PROXY=true).
# TLS_CERT_FILE=/etc/ssl/cc.crt
# TLS_KEY_FILE=/etc/ssl/cc.key
# TRUST_PROXY=true
SESSION_IDLE_HOURS=8
SIGNIN_PER_MINUTE=60
# Hosts the server may call (comma-separated; a name allows those below it). Otherwise set in Settings.
# SALESFORCE_HOSTS=yourcompany.lightning.force.com,yourcompany.my.salesforce.com
# CXONE_ALLOWED_HOSTS=checkmarx.net
# GIT_ALLOWED_HOSTS=github.com,api.github.com,gitlab.com,bitbucket.org,api.bitbucket.org,dev.azure.com
# The calculator works until 31 December 2026 unless a product activation code is given (as CxMissionZero).
# MZ_PRODUCT_CODE=MZ1....
# The email server, for "Forgot your password?" and welcome emails. Optional: an Admin can set it in
# Settings → Email server instead. Either way it is tested there before anything is sent.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=credits-center@yourcompany.com
# SMTP_PASSWORD=
# SMTP_FROM=credits-center@yourcompany.com
# Updates (Settings → Updates): where releases come from, and a read-only token for a private repository.
# UPDATE_REPO=cxsmtp/FTR-CC-Dashboard
# UPDATE_GITHUB_TOKEN=
# Seal backups with a passphrase (keep it safe: a sealed backup cannot be restored without it).
# BACKUP_PASSPHRASE=
# A company proxy for outbound calls (updates, Checkmarx One, git, Let's Encrypt).
# HTTPS_PROXY=http://proxy.yourcompany.com:8080
# HTTPS is on by default (self-signed until you upload a certificate or get one from Let's Encrypt in Settings → HTTPS).
# HTTPS=on
# LETSENCRYPT_DOMAIN=credits.yourcompany.com
# LETSENCRYPT_EMAIL=appsec@yourcompany.com
